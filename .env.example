# Copy to .env.local for local dev, or add to GitHub Actions Secrets for Firebase Hosting deploys.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: reCAPTCHA v3 site key for Firebase App Check (recommended for AI Logic)
VITE_FIREBASE_RECAPTCHA_SITE_KEY=
